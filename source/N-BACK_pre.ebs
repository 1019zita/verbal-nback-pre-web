'--------------------------------------------------------------------------
' Implementation
'--------------------------------------------------------------------------
Sub SessionProc_Run(c as Context)
	
	
	instruction.InputMasks.Reset
	
	instructionEchoClients.RemoveAll
	instruction.InputMasks.Add Keyboard.CreateInputMask("s", "", CLng(instruction.Duration), CLng("1"), ebEndResponseActionTerminate, CLogical("Yes"), "", "", "ResponseMode:All ProcessBackspace:Yes")

	
	instruction.Run
	List1.Run c
	
	
	ImageDisplay1.InputMasks.Reset
	
	ImageDisplay1EchoClients.RemoveAll
	ImageDisplay1.InputMasks.Add Keyboard.CreateInputMask("{ANY}", "", CLng(ImageDisplay1.Duration), CLng("1"), ebEndResponseActionTerminate, CLogical("Yes"), "", "", "ResponseMode:All ProcessBackspace:Yes")

	
	ImageDisplay1.Run

	c.Log
End Sub

Sub procA_Run(c as Context)
	
	
	cueone.InputMasks.Reset
	
	cueoneEchoClients.RemoveAll
	cueone.InputMasks.Add Keyboard.CreateInputMask("s", "", CLng(cueone.Duration), CLng("1"), ebEndResponseActionTerminate, CLogical("Yes"), "", "", "ResponseMode:All ProcessBackspace:Yes")

	
	cueone.Run
	oneback.Run c
	
	
	rest.InputMasks.Reset
	
	restEchoClients.RemoveAll
	rest.InputMasks.Add Keyboard.CreateInputMask("s", "", CLng(rest.Duration), CLng("1"), ebEndResponseActionTerminate, CLogical("Yes"), "", "", "ResponseMode:All ProcessBackspace:Yes")

	
	rest.Run

	c.Log
End Sub

